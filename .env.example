# Clave secreta para Flask. Puedes generar una con: python -c 'import os; print(os.urandom(24).hex())'
SECRET_KEY=

# URL de conexión a la base de datos. Para empezar, puedes usar SQLite.
# DATABASE_URL="sqlite:///project.db"
# O si tienes PostgreSQL corriendo localmente:
# DATABASE_URL="postgresql://user:password@localhost/dbname"
DATABASE_URL=

# Claves de la API de Stripe (usa tus claves de prueba del dashboard de Stripe)
STRIPE_API_KEY=

# --- Variables para el Frontend (Vite) ---

# URL base del frontend. Suele ser esta para desarrollo local.
FRONTEND_URL="http://localhost:5173"

# URL completa del backend que el frontend debe consumir.
VITE_API_BASE_URL="http://127.0.0.1:5000"

# Clave de la API de Google Maps para la funcionalidad de Places Autocomplete.
VITE_GOOGLE_MAPS_API_KEY=
